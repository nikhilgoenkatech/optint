{
  "compilerOptions": {
    "target":            "ES2020",
    "lib":               ["ES2020", "DOM"],
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "baseUrl":           ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
